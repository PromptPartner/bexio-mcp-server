# Copy to .env next to docker-compose.yml.

# Public hostname of the gateway. Caddy requests the TLS certificate for it,
# so its DNS record must point to this server and ports 80/443 must be reachable.
GATEWAY_DOMAIN=bexio-mcp.example.ch

# Client ID of your app on developer.bexio.com.
# Register this redirect URL there: https://<GATEWAY_DOMAIN>/oauth/callback
BEXIO_CLIENT_ID=

# Optional: space-separated Bexio scopes (default: everything the tools need,
# payroll read-only). Must contain offline_access.
# BEXIO_SCOPES=openid profile email company_profile offline_access contact_edit kb_invoice_edit

# Optional: only register these tool categories (see README).
# BEXIO_ENABLED_CATEGORIES=contacts,invoices,quotes,orders,projects,timetracking

# Optional: close idle MCP sessions after this many minutes.
# MCP_SESSION_TTL_MINUTES=60
